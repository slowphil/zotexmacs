{
  "manifest_version": 2,
  "name": "Zotexmacs",
  "version": "0.7",
  "description": "Have Zotero interact with GNU TeXmacs",
  "author": "Philippe Joyez",
  "homepage_url": "https://github.com/slowphil/zotexmacs",
  "icons": {
    "48": "skin/zotexmacs.png"
  },
  "applications": {
    "zotero": {
      "id": "zotexmacs@texmacs.org",
      "strict_min_version": "8.0",
      "strict_max_version": "10.0.*",
      "update_url": "https://raw.githubusercontent.com/slowphil/zotexmacs/master/update.json"
    }
  }
}
